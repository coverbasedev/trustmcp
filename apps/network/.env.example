# TrustMCP Network configuration (copy to .env for local dev)
TRUSTMCP_ENVIRONMENT=development
TRUSTMCP_DATABASE_URL=sqlite:///./.data/trustmcp.db
TRUSTMCP_PUBLIC_BASE_URL=http://localhost:8000

# Shared secret the web backend uses to create/manage vendors
TRUSTMCP_SERVICE_TOKEN=dev-service-token

# Freshness + key policy
TRUSTMCP_EXPIRING_WINDOW_DAYS=30
TRUSTMCP_KEY_TTL_DAYS=90

# Storage: leave S3 empty to use local filesystem with signed redirect URLs.
# TRUSTMCP_S3_BUCKET=trustmcp-artifacts
# TRUSTMCP_S3_REGION=us-east-1
# TRUSTMCP_S3_ENDPOINT_URL=http://localhost:9000   # MinIO
# TRUSTMCP_S3_ACCESS_KEY_ID=minioadmin
# TRUSTMCP_S3_SECRET_ACCESS_KEY=minioadmin
TRUSTMCP_STORAGE_LOCAL_DIR=./.data/artifacts
TRUSTMCP_SIGNED_URL_TTL_SECONDS=300

# Email (owner notifications + freshness nudges). No-ops if TRUSTMCP_SMTP_HOST is empty.
TRUSTMCP_SMTP_HOST=
TRUSTMCP_SMTP_PORT=587
TRUSTMCP_SMTP_USERNAME=
TRUSTMCP_SMTP_PASSWORD=
TRUSTMCP_SMTP_FROM=TrustMCP <no-reply@trustmcp.org>
TRUSTMCP_SMTP_STARTTLS=true

# CRM + Docusign are configured PER TRUST CENTER in the web UI (each customer
# brings their own credentials, and CRM can connect via an API token OR their own
# MCP server). The network-global vars below are only an optional fallback default.
# CRM for auto-release on verified customer relationship (configure one)
TRUSTMCP_HUBSPOT_TOKEN=
TRUSTMCP_SALESFORCE_INSTANCE_URL=
TRUSTMCP_SALESFORCE_ACCESS_TOKEN=
