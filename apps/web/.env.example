# --- Web app ---
# Local dev DB (Postgres in prod). For quick local runs you can use SQLite:
#   DATABASE_URL="file:./dev.db"   (and set provider="sqlite" in prisma/schema.prisma)
DATABASE_URL="postgresql://trustmcp:trustmcp@localhost:5432/trustmcp_web?schema=public"

# Auth.js
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Enable real OAuth by setting these (otherwise a dev credentials login is offered):
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Enterprise SSO via a generic OIDC provider (Okta / Entra ID / Auth0 / Google Workspace).
SSO_NAME="Acme SSO"
SSO_ISSUER=""
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""

# Set to "1" to allow the email/dev credentials login (local only).
AUTH_DEV_LOGIN="1"
# Email sign-in link signup/login (verifies email ownership). nodemailer SMTP URL.
# e.g. smtp://user:pass@smtp.host:587  (or a provider relay)
EMAIL_SERVER=""
EMAIL_FROM="TrustMCP <no-reply@trustmcp.org>"

# --- CRM relationship verification (optional; assists access approval) ---
# NOTE: CRM (HubSpot/Salesforce) and Docusign are configured PER TRUST CENTER in
# the app UI now (Trust center → Settings → CRM connection / Docusign), so each
# customer uses their own credentials. The network-global env vars below remain
# only as an optional fallback default; most deployments leave them unset.
HUBSPOT_TOKEN=""
# Salesforce (REST): an instance URL + a valid OAuth access token
SALESFORCE_INSTANCE_URL=""
SALESFORCE_ACCESS_TOKEN=""

# --- Product analytics (PostHog, optional) ---
# Public, client-side keys — safe to expose. No-ops if the key is unset.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Error tracking (Sentry, optional) ---
# Browser DSN (public). No-ops if unset.
NEXT_PUBLIC_SENTRY_DSN=""
# Server-side DSN (defaults to NEXT_PUBLIC_SENTRY_DSN when unset).
SENTRY_DSN=""
# Source-map upload at build time (CI/deploy only; omit locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- TrustMCP network ---
TRUSTMCP_NETWORK_URL="http://localhost:8000"
TRUSTMCP_SERVICE_TOKEN="dev-service-token"
# The public base of this web app (used in discovery records).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
