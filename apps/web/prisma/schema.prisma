// TrustMCP web app database. Stores auth, orgs, and the mapping from an org's trust
// center to its network vendor id + owner token. The assurance evidence itself
// lives in the TrustMCP Network, never here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) models ---

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- TrustMCP domain models ---

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  // Email domains (e.g. "acme.com") whose users auto-join this workspace on
  // sign-in with the role below. Empty = no automatic membership.
  allowedDomains String[]    @default([])
  // Role granted to users who auto-join via a whitelisted domain.
  domainJoinRole String      @default("viewer")
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  trustCenters TrustCenter[]
  invitations  Invitation[]
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        String       @default("viewer") // admin | reviewer | viewer
  token       String       @unique
  status      String       @default("pending") // pending | accepted | revoked
  invitedById String
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("owner") // owner | admin | reviewer | viewer
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// Maps an org's trust center to its network vendor. The owner token authenticates
// management calls to the TrustMCP Network and is held only server-side.
model TrustCenter {
  id          String       @id @default(cuid())
  orgId       String
  vendorId    String       @unique
  ownerToken  String
  legalName   String
  createdById String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Tracks a "Trust Center AI Migration": importing an existing/external trust
// center into this one. A Browserbase session crawls the source URL, requests
// documentation (signing an NDA if required), pauses for the source owner to
// release documents, and on Resume pulls everything in and copies it over.
// Lives in the web DB (not the network) because the pause/resume happens in
// this dashboard; the imported evidence itself still lands in the network.
model TrustCenterMigration {
  id                   String   @id @default(cuid())
  // Target trust center we are populating (TrustCenter.vendorId).
  vendorId             String
  // The existing trust center we are importing from.
  sourceUrl            String
  // Who we identify as when requesting access on the source.
  requesterName        String?
  requesterEmail       String?
  requesterCompany     String?
  // Free-form access details (login hints, invite code, instructions).
  accessNotes          String?
  // pending | requesting | awaiting_release | importing | completed | failed
  status               String   @default("pending")
  // Human-readable description of the current step or the failure reason.
  statusDetail         String?
  // Browserbase session id + live/replay URL so the user can watch the crawl.
  browserbaseSessionId String?
  sessionReplayUrl     String?
  ndaSigned            Boolean  @default(false)
  importedCount        Int      @default(0)
  // Structured step log: [{ at, step, detail }].
  log                  Json?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([vendorId])
}

// --- MCP Audit subsystem ---
//
// An org brings its own LLM credentials, then scans MCP servers for integration
// risk. The scan record holds the whole audit (tool inventory, research, probes,
// controls, scorecard, evidence) as versioned JSON, plus an optional publish link
// to one of the org's trust centers so a vendor can self-scan and publish the
// scorecard on its public page.

// A per-org LLM provider credential. The API key is encrypted at rest (crypto.ts);
// it is used only server-side by the audit engine and never returned to a client.
model LlmCredential {
  id             String   @id @default(cuid())
  orgId          String
  provider       String // "anthropic" | "openai"
  label          String?
  // Default model id for this credential (e.g. "claude-opus-4-6", "gpt-5.1").
  model          String
  apiKeyEnc      String
  baseUrl        String?
  createdById    String
  createdAt      DateTime @default(now())
  lastVerifiedAt DateTime?
  status         String   @default("unverified") // unverified | ok | error

  @@index([orgId])
}

// An org-defined custom control ("clause") merged into every scan alongside the
// static controls. Lets a team encode reusable policy checks they want validated
// across every MCP server in their environment.
model AuditClause {
  id          String   @id @default(cuid())
  orgId       String
  dimension   String // a RISK_DIMENSIONS id
  title       String
  intent      String
  weight      Float?   @default(0.6)
  enabled     Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@index([orgId])
}

// One audit of one MCP server. Runs detached and persists progress here so the
// dashboard can poll. Secrets (target auth) are stored encrypted in authSecretEnc;
// only the display shape lives in authKind/authDetail.
model McpAuditScan {
  id                String   @id @default(cuid())
  orgId             String
  createdById       String
  name              String
  // Operator-editable description (used when publishing a self-scan).
  description       String?
  targetUrl         String
  transport         String   @default("http") // http | sse | stdio
  authKind          String   @default("none")
  authDetail        String?
  authSecretEnc     String?
  // Context the operator gives about what they'll use the server for.
  intendedUse       String?
  // Integration points the operator described (array of strings).
  integrationPoints Json?
  // Which LLM ran this scan.
  provider          String
  model             String
  // pending | inspecting | researching | probing | scoring | completed | failed
  status            String   @default("pending")
  statusDetail      String?
  overallScore      Int?
  grade             String?
  // Result blobs (see lib/mcp-audit/types.ts).
  toolInventory     Json?
  research          Json?
  probes            Json?
  controls          Json?
  scorecard         Json?
  evidence          Json?
  // Interrogation transcript from the MCP interaction layer.
  interactions      Json?
  // Structured step log: [{ at, phase, detail }].
  log               Json?
  // Publishing: link a completed scan to a trust center's public page.
  published         Boolean  @default(false)
  publishedVendorId String?
  publishSlug       String?  @unique
  publishedVersion  String?
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orgId])
  @@index([publishedVendorId])
}

// Contact details left by visitors on the /resources landing page (the QR-code
// destination used in talks and presentations). Purely a lead-capture record —
// the resources themselves are never gated on a submission.
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  // Where the lead came from, so future landing pages can share this table.
  source    String   @default("resources")
  createdAt DateTime @default(now())

  @@index([email])
}
